# Copy to .env locally. Never commit .env or paste keys into chat.

# --- Odds-API.io (Growth 10 books + WebSocket) ---
# Put the key here yourself. Cloud agents must not ask for or embed it.
ODDS_API_KEY=
ODDS_API_WS=true
# Multi-sport default: baseball + soccer (football) + NFL/CFB.
# Do NOT set ODDS_API_WS_LEAGUES=usa-mlb on this connection — that drops soccer/CFB.
# Baseball-only slice: ODDS_API_SPORTS=baseball (then usa-mlb is pinned automatically).
ODDS_API_SPORTS=baseball,football,american-football
ODDS_API_LEAGUE_MLB=usa-mlb
# Default 10 catalog names (BookMaker.eu is catalog-inactive — do not add it):
# ODDS_API_BOOKMAKERS=DraftKings,FanDuel,BetMGM,Betfair Exchange,Circa,Polymarket,Bet365,Caesars,Kalshi,NoVig
# Send Betfair Exchange on the wire. Override only if your account uses another label:
# ODDS_API_BETFAIR_REQUEST_NAME=Betfair Sportsbook
# Optional: PUT /bookmakers/selected/select for the 10 names on WS startup
# ODDS_API_SELECT_BOOKS=false
# WS filters (defaults: sport=baseball,football,american-football, no leagues pin, no status = prematch+live)
# ODDS_API_WS_MARKETS=ML,Spread,Totals
# ODDS_API_WS_CHANNELS=odds
# ODDS_API_WS_STATUS=
# ODDS_API_WS_EVAL_INTERVAL_SEC=1.0
# Recovery (defaults): 1013/backoff with jitter; REST /odds/updated is single-flight + cooldown.
# ODDS_API_WS_RECONNECT_BASE_SEC=2
# ODDS_API_WS_RECONNECT_MAX_SEC=60
# ODDS_API_WS_RECONNECT_JITTER=0.25
# ODDS_API_WS_1013_BASE_SEC=8
# ODDS_API_WS_1013_MAX_SEC=120
# ODDS_API_WS_HEALTHY_RESET_SEC=15
# ODDS_API_REST_FALLBACK_COOLDOWN_SEC=20
# ODDS_API_REST_FALLBACK_429_COOLDOWN_SEC=60
# ODDS_API_REST_UPDATED_FALLBACK=true
# Live scan: majors only by default (NCAAF/NFL/NBA/NCAAB/NHL/MLB + top soccer).
# Set false only if you want the window padded with lower leagues.
# ODDS_LIVE_SCAN_MAJORS_ONLY=true
# ODDS_LIVE_SCAN_MAX_EVENTS=80

# --- PLive Pandora (local take venue; no login, no cookies, no BetBCK) ---
# Public handshake: setSocketMetadata {partnerId:113, flavor:live} then subscribe/getCache.
# One eventData directory. MLB = #!/sport/1. Soccer = #!/sport/5. Top Soccer = #!/sport/220.
# Odds-API event IDs do not join PLive — soccer uses a separate conservative fixture match.
# PLIVE_ENABLED=true
# PLIVE_SPORT_IDS=1,5,220
# PLIVE_PAGE=https://plive.becoms.co/live/?#!/sport/5
# PLIVE_START_TOLERANCE_SEC=900
# PLIVE_STALE_SEC=90
# PLIVE_ORIGIN=https://plive.becoms.co
# PLIVE_URL=wss://pandora.ganchrow.com

# --- Kalshi / dashboard ---
# Alert cards follow monitor presence (WS-driven). Orphan safety-net only:
# ALERT_ORPHAN_SEC=300
# (legacy aliases ALERT_STALE_SEC / ALERT_TTL_SEC still accepted)

# KALSHI_KEY_ID=
# KALSHI_KEY_FILE=kalshi.key
# KALSHI_EMAIL=
# KALSHI_PASSWORD=
# DASHBOARD_USERNAME=
# DASHBOARD_PASSWORD=
# Global auto-bet stays OFF at process start. Enable from the dashboard when ready.
